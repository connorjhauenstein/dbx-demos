{
  "__inputs": [],
  "__requires": [],
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 6,
      "title": "Ticks / sec",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "postgres", "uid": "lakebase" },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "lakebase" },
          "rawQuery": true,
          "rawSql": "SELECT SUM(ticks) AS ticks_per_sec FROM market.quote_1s WHERE window_start = (SELECT max(window_start) FROM market.quote_1s)",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "blue" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "id": 7,
      "title": "Rows in Lakebase",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "postgres", "uid": "lakebase" },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "lakebase" },
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS total_rows FROM market.quote_1s",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "purple" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "id": 8,
      "title": "Open Alerts",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "postgres", "uid": "lakebase" },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "lakebase" },
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS open_alerts FROM market.alerts WHERE status = 'open'",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "id": 1,
      "title": "Spread by Venue (bps)",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "postgres", "uid": "lakebase" },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "lakebase" },
          "rawQuery": true,
          "rawSql": "SELECT window_start AS time, venue, spread_bps\nFROM market.quote_1s\nWHERE symbol = 'BTC-USD' AND $__timeFilter(window_start)\nORDER BY window_start",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": {} },
        "overrides": []
      },
      "options": {
        "dataLinks": [],
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "id": 2,
      "title": "Acme vs Best Competitor (bps)",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "postgres", "uid": "lakebase" },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "lakebase" },
          "rawQuery": true,
          "rawSql": "SELECT window_start AS time, spread_bps AS acme_spread_bps, best_competitor_bps, delta_bps\nFROM market.spread_vs_best\nWHERE symbol = 'BTC-USD' AND venue = 'acme' AND $__timeFilter(window_start)\nORDER BY window_start",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": {} },
        "overrides": []
      },
      "options": {
        "dataLinks": [],
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "id": 3,
      "title": "Book Depth by Venue (BTC)",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 13 },
      "datasource": { "type": "postgres", "uid": "lakebase" },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "lakebase" },
          "rawQuery": true,
          "rawSql": "SELECT window_start AS time, venue, (depth_bid + depth_ask) / NULLIF(ticks, 0) AS avg_depth_btc\nFROM market.quote_1s\nWHERE symbol = 'BTC-USD' AND $__timeFilter(window_start)\nORDER BY window_start",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": {} },
        "overrides": []
      },
      "options": {
        "dataLinks": [],
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "id": 4,
      "title": "RTM End-to-End Latency (ms)",
      "type": "timeseries",
      "timeFrom": "30s",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 13 },
      "datasource": { "type": "postgres", "uid": "lakebase" },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "lakebase" },
          "rawQuery": true,
          "rawSql": "SELECT\n  window_start AS time,\n  ROUND(AVG(write_latency_ms))::int AS \"E2E Latency (ms)\"\nFROM market.quote_1s\nWHERE symbol = 'BTC-USD'\n  AND write_latency_ms IS NOT NULL\n  AND window_start > now() - interval '30 seconds'\nGROUP BY window_start\nORDER BY window_start",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "dataLinks": [],
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    }
  ],
  "refresh": "1s",
  "schemaVersion": 38,
  "tags": [],
  "time": { "from": "now-5m", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["1s", "2s", "5s", "10s", "30s", "1m", "5m"]
  },
  "timezone": "browser",
  "title": "Market Monitor",
  "uid": "market-monitor",
  "version": 4
}
