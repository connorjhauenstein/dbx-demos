# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.

# ── EC2 (Kafka + Grafana) ──────────────────────────────────────────────────────
EC2_HOST=<ec2-public-dns>              # e.g. ec2-203-0-113-10.compute-1.amazonaws.com
EC2_SG_ID=<security-group-id>         # e.g. sg-0123456789abcdef0
AWS_PROFILE=<aws-cli-profile>          # e.g. aws-sandbox-field-eng_databricks-sandbox-admin

# ── Kafka ──────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP=${EC2_HOST}:9092
KAFKA_TOPIC=md.quotes.normalized

# ── Lakebase (Postgres) ────────────────────────────────────────────────────────
# Get these after running: python3 deploy/lakebase_provision.py
LAKEBASE_ENDPOINT=<instance-name>      # the --name value passed to databricks database create-database-instance
LAKEBASE_HOST=<ep-xxxx.databricks.com> # printed by lakebase_provision.py
LAKEBASE_DB=databricks_postgres
LAKEBASE_ADMIN_EMAIL=<your-databricks-email>

# Passwords — set in lakebase/02_roles.sql (choose your own)
LAKEBASE_PASSWORD=<set-me>          # grafana_reader Postgres role (also used by Grafana OSS datasource)
LAKEBASE_WRITER_PASSWORD=<set-me>   # rtm_writer Postgres role

# ── Generator ─────────────────────────────────────────────────────────────────
GEN_RATE_PER_SYMBOL=500                # ticks/sec per symbol per venue

# ── Alerting ──────────────────────────────────────────────────────────────────
ALERT_THRESHOLD_BPS=8                  # fire alert when delta_bps exceeds this

# ── Databricks bundle ─────────────────────────────────────────────────────────
DATABRICKS_PROFILE=<your-databricks-cli-profile>
UC_CATALOG=<your-unity-catalog>        # catalog where tables and checkpoints live
UC_SCHEMA=rtm_demo

# Job IDs — printed by `databricks bundle deploy`, or find them in Workflows UI
RTM_JOB_ID=<your-rtm-job-id>
POLLER_JOB_ID=<your-alert-poller-job-id>

# EC2 instance ID — from AWS console or `aws ec2 describe-instances`
EC2_INSTANCE_ID=<your-ec2-instance-id>

# ── Linear (optional) ─────────────────────────────────────────────────────────
# Omit or leave blank to use stub mode (returns STUB-XXXXXX)
LINEAR_API_KEY=
LINEAR_TEAM_ID=
